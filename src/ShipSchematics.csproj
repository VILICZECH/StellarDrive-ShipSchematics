<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build: dotnet build src/ShipSchematics.csproj -c Release -p:GameDir="<path to the Stellar Drive folder>"
    The game folder must have MelonLoader installed. Add -p:CopyToMods=true to copy the DLL into the game's Mods folder.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ShipSchematics</AssemblyName>
    <RootNamespace>ShipSchematics</RootNamespace>
    <Version>1.0.2</Version>
    <Description>Save a ship with its wiring, rotor and piston heads and docked ships, and build it again anywhere.</Description>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\StellarDrive Demo</GameDir>
    <Managed>$(GameDir)\StellarDrive_Data\Managed</Managed>
    <CopyToMods Condition="'$(CopyToMods)' == ''">false</CopyToMods>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The game runs on Mono (mscorlib 4), so the mod targets net472 and uses MelonLoader's net472 build. -->
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(GameDir)\MelonLoader\net472\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\MelonLoader\net472\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(Managed)\netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Core"><HintPath>$(Managed)\Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FishNet.Runtime"><HintPath>$(Managed)\FishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Items.Interface"><HintPath>$(Managed)\Items.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Items.Model"><HintPath>$(Managed)\Items.Model.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Managers.Interface"><HintPath>$(Managed)\Managers.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Players"><HintPath>$(Managed)\Players.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Players.Interface"><HintPath>$(Managed)\Players.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="QuickOutline"><HintPath>$(Managed)\QuickOutline.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Saving"><HintPath>$(Managed)\Saving.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Saving.Interface"><HintPath>$(Managed)\Saving.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Saving.Serialization"><HintPath>$(Managed)\Saving.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ships"><HintPath>$(Managed)\Ships.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ships.Interface"><HintPath>$(Managed)\Ships.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Memory"><HintPath>$(Managed)\System.Memory.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Tools"><HintPath>$(Managed)\Tools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UI"><HintPath>$(Managed)\UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UI.Interface"><HintPath>$(Managed)\UI.Interface.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(Managed)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Localization"><HintPath>$(Managed)\Unity.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(Managed)\UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(Managed)\UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WorldTracking"><HintPath>$(Managed)\WorldTracking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WorldTracking.Interface"><HintPath>$(Managed)\WorldTracking.Interface.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToGameMods" AfterTargets="Build" Condition="'$(CopyToMods)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>
</Project>
